# Kokoadb environment configuration
# Load with: set -a; source ./kokoadb.env; set +a

# ============================================================
# Server and authentication
# ============================================================
KOKOADB_PORT=6543
# Prefix for every HTTP route. Default Admin UI: /_/kdb/admin/
KOKOADB_BASE_PATH=/_/kdb
# Authentication mode: access_key|none. Use none only for trusted local development.
KOKOADB_AUTH_MODE=access_key
# Required in access_key mode; also used as the browser Basic-auth password.
KOKOADB_ACCESS_KEY=
# Comma-separated origins for standalone browser clients. Bundled Admin UI is same-origin.
KOKOADB_CORS_ALLOWED_ORIGINS=
# Maximum request body size and operation execution time.
KOKOADB_MAX_REQUEST_BYTES=16777216
KOKOADB_OPERATION_TIMEOUT_MS=30000

# ============================================================
# Built-in admin web interfaces
# ============================================================
# Admin UI is served from ${KOKOADB_BASE_PATH}/admin/.
KOKOADB_ADMIN_UI_ENABLED=true
# Docs are served from ${KOKOADB_BASE_PATH}/doc.
KOKOADB_DOCS_ENABLED=true

# ============================================================
# Storage
# ============================================================
# DATA_DIR is the persistent volume mount point inside the container. It must be writable by the container.
KOKOADB_DATA_DIR=./data

# STORAGE_MODE:
# local: durable local DB files;
# s3: local working files plus S3 WAL/snapshots.
KOKOADB_STORAGE_MODE=local

# Required when KOKOADB_STORAGE_MODE=s3.
KOKOADB_S3_BUCKET=
KOKOADB_S3_PREFIX=data/kokoadb/data
KOKOADB_S3_REGION=us-east-1
KOKOADB_S3_ENDPOINT=
KOKOADB_S3_ACCESS_KEY=
KOKOADB_S3_SECRET_KEY=
KOKOADB_S3_SESSION_TOKEN=

# ============================================================
# Runtime profile and bounded concurrency
# ============================================================
# balanced: standard defaults; memory: smaller caches/queues; throughput: larger batches/concurrency.
KOKOADB_RUNTIME_PROFILE=balanced
# Optional profile override for the active/open DB LRU cap.
KOKOADB_MAX_ACTIVE_DBS=100
# Shared concurrency budget for reaper, backup, job, and remote-sync DB work.
KOKOADB_WORKER_CONCURRENCY=4

# ============================================================
# S3 replication and snapshots
# ============================================================
# S3 deployment topology:
# - single (default): one active Kongo instance; no cross-instance polling.
# - multi: multiple active instances; poll manifests for remote checkpoints.
# Writer leases remain enabled in both modes as a split-brain guard.
KOKOADB_S3_TOPOLOGY=single
# sync waits for remote replication; async flushes in the background.
KOKOADB_REPLICATION_MODE=async
# Comma-separated DB paths to load at startup in s3 mode.
KOKOADB_PRELOAD_DBS=
# Create a portable snapshot after this many writes.
KOKOADB_SNAPSHOT_EVERY_WRITES=100
KOKOADB_SNAPSHOT_RETENTION_DAYS=14
# Multi-topology manifest polling interval. Ignored in single topology; 0 disables polling.
KOKOADB_REMOTE_SYNC_INTERVAL_SECS=10

# ============================================================
# Read, write, query, and response behavior
# ============================================================
# Read cache TTL. 0 disables the read cache.
KOKOADB_CACHE_TTL_SECS=60
# direct bypasses the coordinator; committed waits; accepted queues and acknowledges.
KOKOADB_WRITE_MODE=committed
KOKOADB_QUERY_DEFAULT_LIMIT=50
# Maximum number of independent child queries accepted by one multi_query request.
KOKOADB_QUERY_MULTI_MAX_QUERIES=20
KOKOADB_QUERY_LOOKUP_MAX_DEPTH=3
KOKOADB_QUERY_LOOKUP_UNCAPPED_OVERRIDE_ENABLED=false
KOKOADB_RESPONSE_INCLUDE_SYSTEM_TIMESTAMPS=true
KOKOADB_RESPONSE_INCLUDE_NAMESPACE=false
KOKOADB_STRICT_MUTATIONS_OPERATORS=false

# ============================================================
# Data lifecycle
# ============================================================
# Empty means no automatic archive purge/default delete TTL.
KOKOADB_ARCHIVE_TTL_SECS=
KOKOADB_DELETE_DEFAULT_TTL_SECS=
# Internal system catalog history retention.
KOKOADB_SYSTEM_RETENTION_DAYS=14

# ============================================================
# Metric events
# ============================================================
# Metrics are always available. Cache TTL 0 disables only metrics-query caching.
KOKOADB_METRIC_EVENTS_CACHE_TTL_SECS=30
# Empty keeps raw metric events indefinitely.
KOKOADB_METRIC_EVENTS_RETENTION_DAYS=

# ============================================================
# Backup, export, and background jobs
# ============================================================
# Local path or full s3://bucket/prefix. Used by manual and automatic backups.
KOKOADB_BACKUP_PATH=./backups
# 0 disables automatic backup. Positive values provide change-aware max staleness.
KOKOADB_BACKUP_EVERY_SECS=0
KOKOADB_BACKUP_RETENTION_DAYS=30
# Local path or full s3://bucket/prefix for generated JSONL exports.
KOKOADB_EXPORT_PATH=./exports
# Shared retention for terminal import/export job history.
KOKOADB_JOB_RETENTION_DAYS=30
